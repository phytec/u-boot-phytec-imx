boot_script_dhcp=net_boot_fit.scr.uimg
console=ttyLP3,CONFIG_BAUDRATE
emmc_dev=0 /* This is needed by built-in uuu flash scripts */
fdt_addr_r=0xD9000000
fdtfile=CONFIG_DEFAULT_FDT_FILE
fdtoverlay_addr_r=0xD9100000
ip_dyn=no
ipaddr=192.168.3.11
kernel_addr_r=0xD0000000
kernel_comp_addr_r=0xD3000000
kernel_comp_size=0x2000000
mmcautodetect=yes
mmcdev=CONFIG_SYS_MMC_ENV_DEV
netmask=255.225.255.0
nfs_eth_dev=eth1
nfsroot=/srv/nfs
pxefile_addr_r=0xD9300000
ramdisk_addr_r=0xD5000000
script_offset_f=0x400000
script_size_f=0x2000
scriptaddr=0xD9200000
sd_dev=1 /* This is needed by built-in uuu flash scripts */
serverip=192.168.3.10
