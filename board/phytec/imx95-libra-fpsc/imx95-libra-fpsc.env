bootmeths=script
boot_targets=mmc2 mmc1 ethernet
boot_script_dhcp=boot.scr.uimg
bootenv_addr_r=0xD9110000
console=ttyLP6,CONFIG_BAUDRATE
emmc_dev=2
fdt_addr_r=0xD9000000
fdtfile=CONFIG_DEFAULT_FDT_FILE
fit_fdtconf=conf-imx95-libra-rdk-fpsc.dtb
fdtoverlay_addr_r=0xD9100000
image=Image
ip_dyn=yes
kernel_addr_r=0xD0000000
kernel_comp_addr_r=0xD3000000
kernel_comp_size=0x2000000
mmcautodetect=yes
mmcdev=CONFIG_SYS_MMC_ENV_DEV
mmcpart=1
mmcroot=2
nfsroot=/srv/nfs
pxefile_addr_r=0x58600000
ramdisk_addr_r=0xD5000000
scriptaddr=0xD9200000
script_offset_f=0x400000
script_size_f=0x2000
sd_dev=1
