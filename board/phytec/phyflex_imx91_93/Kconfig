
if TARGET_PHYFLEX_IMX91 || TARGET_PHYFLEX_IMX93

config SYS_BOARD
	default "phyflex_imx91_93"

config SYS_VENDOR
	default "phytec"

config SYS_CONFIG_NAME
	default "phyflex_imx91_93"

config PHYFLEX_IMX91_93_RAM_STATIC
	bool "Set phyFLEX-i.MX91/93 RAM type and size fix instead of detecting"
	default false
	help
	  RAM type and size is being automatically detected with the help
	  of the PHYTEC EEPROM introspection data.
	  Set RAM size to a fix value instead.

choice
	prompt "phyFLEX-i.MX91/93 RAM type"
	depends on PHYFLEX_IMX91_93_RAM_STATIC
	default PHYFLEX_IMX91_93_RAM_LPDDR4X_1GB

config PHYFLEX_IMX91_93_RAM_LPDDR4X_1GB
	bool "LPDDR4X 1GB RAM"
	help
	  Set RAM type fixed to LPDDR4X and RAM size fixed to 1GB
	  for phyFLEX-i.MX91/93.

config PHYFLEX_IMX91_93_RAM_LPDDR4X_2GB
	bool "LPDDR4X 2GB RAM"
	help
	  Set RAM type fixed to LPDDR4X and RAM size fixed to 2GB
	  for phyFLEX-i.MX91/93.

endchoice

source "board/phytec/common/Kconfig"
endif
